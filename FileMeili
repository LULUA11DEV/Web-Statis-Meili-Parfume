            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            let message = `Halo Admin Meili Parfume,%0ASaya ingin memesan koleksi berikut:%0A%0A`;

            cart.forEach((item, index) => {
                message += `${index + 1}. *${item.name}* (${item.quantity}x) = ${formatRupiah(item.price * item.quantity)}%0A`;
            });

            message += `%0A*Total Tagihan:* ${formatRupiah(subtotal)}`;
            if (subtotal >= 500000) {
                message += `%0A*Bonus:* Free Exclusive Discovery Sample 3ml`;
            }

            message += `%0A%0AMohon bantuannya untuk pemrosesan alamat & pengiriman. Terima kasih!`;

            window.open(`https://wa.me/628578902802?text=${message}`, '_blank');
