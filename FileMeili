        function finishQuiz(projection) {
            quizAnswers['projection'] = projection;
            
            // Match Logic
            let recommended = PRODUCTS[0];
            if (quizAnswers.family) {
                const match = PRODUCTS.find(p => p.category === quizAnswers.family);
                if (match) recommended = match;
            }

            document.querySelectorAll('.quiz-step').forEach(step => step.classList.add('hidden'));
            
            document.getElementById('quiz-recommended-name').innerText = recommended.name;
            document.getElementById('quiz-recommended-notes').innerText = `Notes: ${recommended.topNotes.join(', ')}`;
            document.getElementById('quiz-recommended-reason').innerText = `Berdasarkan preferensi ${quizAnswers.family || 'aroma'} dan suasana ${quizAnswers.occasion || 'sehari-hari'}, ${recommended.name} memberikan perpaduan yang sangat pas dengan kekuatan proyeksi ${projection}.`;
            
            const buyBtn = document.getElementById('quiz-buy-btn');
            buyBtn.onclick = function() {
                closeQuizModal();
                quickViewProduct(recommended.id);
            };

            document.getElementById('quiz-result').classList.remove('hidden');
        }

        function calculateLayering() {
            const p1Id = document.getElementById('layer-1').value;
            const p2Id = document.getElementById('layer-2').value;

            const p1 = PRODUCTS.find(p => p.id === p1Id);
            const p2 = PRODUCTS.find(p => p.id === p2Id);

            const titleEl = document.getElementById('layer-result-title');
            const descEl = document.getElementById('layer-result-desc');

            if (p1Id === p2Id) {
                titleEl.innerText = `"Double Amplified ${p1.name.split('-')[1]}"`;
                descEl.innerText = `Menyemprotkan dua kali produk yang sama memperkuat ketahanan aroma hingga 20+ jam dengan sillage yang sangat pekat.`;
                return;
            }

            titleEl.innerText = `"The Custom Harmonie: ${p1.name.split('-')[1]} & ${p2.name.split('-')[1]}"`;
            descEl.innerText = `Layering antara kesegaran/karakter dasar dari ${p1.name} dengan ${p2.name} menciptakan kedalaman aroma yang sangat personal, unik, dan tidak dapat ditiru oleh siapapun.`;
        }

