        function filterProducts(category) {
            currentFilter = category;
            
            // Update Active Tab Styles
            const buttons = document.querySelectorAll('.category-btn');
            buttons.forEach(btn => {
                btn.classList.remove('active', 'bg-meiliDark', 'text-meiliCream', 'border-meiliGold');
                btn.classList.add('bg-white', 'text-gray-700', 'border-meiliBorder');
            });

            event.target.classList.add('active', 'bg-meiliDark', 'text-meiliCream', 'border-meiliGold');
            event.target.classList.remove('bg-white', 'text-gray-700', 'border-meiliBorder');

            let filtered = category === 'all' ? [...PRODUCTS] : PRODUCTS.filter(p => p.category === category);
            renderProducts(filtered);
        }

        function sortProducts(criteria) {
            let sorted = [...PRODUCTS];
            if (currentFilter !== 'all') {
                sorted = sorted.filter(p => p.category === currentFilter);
            }

            if (criteria === 'price-low') sorted.sort((a,b) => a.price - b.price);
            if (criteria === 'price-high') sorted.sort((a,b) => b.price - a.price);
            if (criteria === 'rating') sorted.sort((a,b) => b.rating - a.rating);

            renderProducts(sorted);
        }

        function addToCart(productId) {
            const product = PRODUCTS.find(p => p.id === productId);
            if (!product) return;

            const existingItem = cart.find(item => item.id === productId);
            if (existingItem) {
                existingItem.quantity += 1;
            } else {
                cart.push({ ...product, quantity: 1 });
            }

            updateCartUI();
            openToast(`'${product.name}' ditambahkan ke keranjang!`);
        }

        function updateQuantity(productId, delta) {
            const item = cart.find(i => i.id === productId);
            if (!item) return;

            item.quantity += delta;
            if (item.quantity <= 0) {
                cart = cart.filter(i => i.id !== productId);
            }

            updateCartUI();
        }

        function updateCartUI() {
            const badge = document.getElementById('cart-badge');
            const container = document.getElementById('cart-items-container');
            const subtotalEl = document.getElementById('cart-subtotal');
            const totalEl = document.getElementById('cart-total');
            const progressBar = document.getElementById('gift-progress-bar');
            const statusText = document.getElementById('gift-progress-status');

            // Total count
            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            badge.innerText = totalItems;

            // Subtotal
            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            subtotalEl.innerText = formatRupiah(subtotal);
            totalEl.innerText = formatRupiah(subtotal);

            // Gift progress logic (Threshold: 500,000)
            const threshold = 500000;
            const progressPercent = Math.min((subtotal / threshold) * 100, 100);
            progressBar.style.width = progressPercent + '%';

            if (subtotal >= threshold) {
                statusText.innerText = 'TERCAPAI! Free Sample 3ml';
                statusText.className = 'text-emerald-600 font-bold';
            } else {
                const remaining = threshold - subtotal;
                statusText.innerText = `Kurang ${formatRupiah(remaining)} lagi`;
                statusText.className = 'text-meiliGoldDark';
            }

            // Render Item List
            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 text-gray-400 space-y-3">
                        <i class="fa-solid fa-bag-shopping text-4xl text-meiliBorder"></i>
                        <p class="font-serif text-sm">Keranjang Anda masih kosong.</p>
                        <button onclick="toggleCartDrawer()" class="text-xs uppercase text-meiliGold font-semibold border-b border-meiliGold pb-0.5">Jelajahi Koleksi</button>
                    </div>
                `;
                return;
            }

            container.innerHTML = cart.map(item => `
                <div class="flex items-center gap-4 p-3 bg-white rounded-xl border border-meiliBorder">
                    <img src="${item.image}" alt="${item.name}" class="w-16 h-16 object-cover rounded-lg bg-meiliCream">
                    <div class="flex-1">
                        <h4 class="font-serif text-sm font-semibold text-meiliDark">${item.name}</h4>
                        <span class="text-xs text-meiliGoldDark font-medium">${formatRupiah(item.price)}</span>
                        
                        <div class="flex items-center gap-3 mt-2">
                            <div class="flex items-center border border-meiliBorder rounded bg-meiliCream">
                                <button onclick="updateQuantity('${item.id}', -1)" class="px-2 py-0.5 text-xs text-gray-600 hover:text-meiliDark">-</button>
                                <span class="px-2 text-xs font-semibold">${item.quantity}</span>
                                <button onclick="updateQuantity('${item.id}', 1)" class="px-2 py-0.5 text-xs text-gray-600 hover:text-meiliDark">+</button>
                            </div>
                        </div>
                    </div>
                    <button onclick="updateQuantity('${item.id}', -${item.quantity})" class="text-gray-300 hover:text-rose-500 text-sm p-2">
                        <i class="fa-solid fa-trash-can"></i>
